# trend_scanner CLI alerts
TELEGRAM_BOT_TOKEN=<YOUR_TELEGRAM_BOT_TOKEN>
TELEGRAM_CHAT_ID=<YOUR_TELEGRAM_CHAT_ID>
DISCORD_WEBHOOK_URL=<YOUR_DISCORD_TRENDS_WEBHOOK_URL>
DISCORD_VETOS_WEBHOOK_URL=<YOUR_DISCORD_VETOS_WEBHOOK_URL>
DISCORD_NO_TREND_WEBHOOK_URL=<YOUR_DISCORD_NO_TREND_WEBHOOK_URL>
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# TradeEye SaaS backend
DEBUG=true
SEED_DEV_USER=true
DATABASE_URL=mysql+aiomysql://<DB_USER>:<DB_PASSWORD>@localhost:3306/<DB_NAME>?charset=utf8mb4
JWT_SECRET_KEY=change-me-to-a-long-random-string
ENCRYPTION_KEY=
SESSION_SECRET_KEY=change-me-session-secret
FRONTEND_URL=http://localhost:5173
WHOP_API_KEY=
WHOP_COMPANY_ID=
WHOP_WEBHOOK_SECRET=
# Post-checkout redirect path appended to FRONTEND_URL
WHOP_BILLING_SUCCESS_PATH=/billing/success
# Whop plan ID for the +50 subscriptions add-on ($5/mo one-time or recurring — create in Whop dashboard)
WHOP_ADDON_PLAN_ID=prod_ZCLOhxcmAC9Yn

# Free trial: full platform access for new users (all timeframes, DEFAULT_SUBSCRIPTION_BARS candles)
TRIAL_DAYS=3
TRIAL_MAX_SUBSCRIPTIONS=100
TRIAL_MAX_TIMEFRAMES=8
# Comma-separated browser origins allowed to call the API (include local + production frontends)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Admin panel
# Generate hash: python3 -c "import bcrypt; print(bcrypt.hashpw(b'your-password', bcrypt.gensalt(12)).decode())"
# Docker Compose: escape $ as $$ in the hash (e.g. $$2b$$12$$...)
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# SMTP (optional — emails logged in dev if unset)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@tradeeye.app
SMTP_USE_TLS=true

CHART_TMP_DIR=/tmp/tradeeye/charts
DEFAULT_SUBSCRIPTION_BARS=2500
SCAN_WORKERS=16
# Set false to skip veto gates in SaaS scans (signals-only mode)
VETOES_ENABLED=true
# Logging: keep false on prod/VPS (DEBUG=true no longer enables SQL or CCXT dumps)
SQL_ECHO=false
SCAN_VERBOSE=false
LOG_LEVEL=INFO
# Log each HTTP request (GET /api/v1/... 200). Off by default to reduce noise during scans.
HTTP_ACCESS_LOG=true
# Seed script: optional Discord webhook for the dev admin user (falls back to DISCORD_WEBHOOK_URL)
SEED_ADMIN_DISCORD_WEBHOOK_URL=
